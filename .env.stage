# File: users-service/backend/.env.stage
PORT=3200
NODE_ENV=staging

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=iapps_users_stage_db

JWT_SECRET=staging-secret-key
JWT_EXPIRATION=1h

API_GATEWAY_URL=https://staging.iappslive.com
AUTH_SERVICE_URL=https://staging-auth.iappslive.com

CORS_ORIGIN=https://staging.iappslive.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=50

SESSION_SECRET=staging-session-key
SESSION_EXPIRATION=86400

MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif
UPLOAD_DIR=./stage-uploads

CACHE_TTL=3600
CACHE_MAX_ITEMS=1000
