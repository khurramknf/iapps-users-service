# File: users-service/backend/.env.prod
PORT=3200
NODE_ENV=production

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secure-prod-password
DB_DATABASE=iapps_users_prod_db

JWT_SECRET=secure-prod-secret
JWT_EXPIRATION=1h

API_GATEWAY_URL=https://api.iappslive.com
AUTH_SERVICE_URL=https://auth.iappslive.com

CORS_ORIGIN=https://iappslive.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=30

SESSION_SECRET=super-secure-prod-session-key
SESSION_EXPIRATION=86400

MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif
UPLOAD_DIR=./uploads

CACHE_TTL=3600
CACHE_MAX_ITEMS=1000
