# File: users-service/backend/.env.dev
PORT=3200
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=pass
DB_DATABASE=iapps_users_dev_db

# JWT Configuration
JWT_SECRET=dev-sec
JWT_EXPIRATION=1h

# Service URLs
API_GATEWAY_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3100

# Security
CORS_ORIGIN=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif
UPLOAD_DIR=./uploads

# Cache
CACHE_TTL=3600
CACHE_MAX_ITEMS=1000
